POSTGRES_DB=trend_radar
POSTGRES_USER=trend_radar
POSTGRES_PASSWORD=replace_with_a_long_random_password
TZ=Asia/Shanghai
# Add the replacement Bright Data key here on the server only.
BRIGHTDATA_API_TOKEN=
COLLECTION_INTERVAL_SECONDS=86400
# Markets collected by the Worker. The dashboard exposes all six markets;
# add SG,MY,TH,VN,PH here when you want their scheduled data collected.
COLLECTION_MARKETS=US
POSTS_PER_KEYWORD=3
# Limit daily Bright Data comment calls to protect the free quota.
COLLECT_COMMENTS=true
MAX_COMMENT_POSTS_PER_RUN=3
# Comma-separated source keys. TikTok is the only default because its discovery
# Dataset is already configured in the starter project. Other sources remain
# visible as pending until their Dataset IDs and input schema are configured.
SOCIAL_PLATFORMS_ENABLED=tiktok
# Bright Data Dataset IDs are account-specific. Do not copy profile examples
# from the docs unless they match the Dataset you enabled in your account.
BRIGHTDATA_TIKTOK_POSTS_DATASET_ID=
BRIGHTDATA_TIKTOK_COMMENTS_DATASET_ID=
# Optional country input field for a TikTok Dataset that explicitly supports it.
# The default TikTok discover-by-keyword Dataset does not expose this field.
BRIGHTDATA_TIKTOK_COUNTRY_FIELD=
# Optional per-market URL inputs for a localized TikTok URL Dataset:
# BRIGHTDATA_TIKTOK_POSTS_INPUTS_SG=
# BRIGHTDATA_TIKTOK_POSTS_INPUTS_MY=
# BRIGHTDATA_TIKTOK_POSTS_INPUTS_TH=
# BRIGHTDATA_TIKTOK_POSTS_INPUTS_VN=
# BRIGHTDATA_TIKTOK_POSTS_INPUTS_PH=
# Optional per-market Dataset IDs when each market uses a separate Dataset:
# BRIGHTDATA_TIKTOK_POSTS_DATASET_ID_SG=
# BRIGHTDATA_TIKTOK_POSTS_DATASET_ID_MY=
# BRIGHTDATA_TIKTOK_POSTS_DATASET_ID_TH=
# BRIGHTDATA_TIKTOK_POSTS_DATASET_ID_VN=
# BRIGHTDATA_TIKTOK_POSTS_DATASET_ID_PH=
BRIGHTDATA_INSTAGRAM_POSTS_DATASET_ID=
BRIGHTDATA_INSTAGRAM_COMMENTS_DATASET_ID=
BRIGHTDATA_INSTAGRAM_POSTS_INPUT_KEY=url
BRIGHTDATA_INSTAGRAM_POSTS_INPUTS=
BRIGHTDATA_INSTAGRAM_COMMENTS_INPUT_KEY=url
BRIGHTDATA_INSTAGRAM_PAYLOAD_MODE=array
BRIGHTDATA_INSTAGRAM_POSTS_MODE=scrape
BRIGHTDATA_YOUTUBE_POSTS_DATASET_ID=
BRIGHTDATA_YOUTUBE_COMMENTS_DATASET_ID=
BRIGHTDATA_YOUTUBE_POSTS_INPUT_KEY=url
BRIGHTDATA_YOUTUBE_POSTS_INPUTS=
BRIGHTDATA_YOUTUBE_COMMENTS_INPUT_KEY=url
BRIGHTDATA_YOUTUBE_PAYLOAD_MODE=array
BRIGHTDATA_YOUTUBE_POSTS_MODE=scrape
BRIGHTDATA_FACEBOOK_POSTS_DATASET_ID=
BRIGHTDATA_FACEBOOK_COMMENTS_DATASET_ID=
BRIGHTDATA_FACEBOOK_POSTS_INPUT_KEY=url
BRIGHTDATA_FACEBOOK_POSTS_INPUTS=
BRIGHTDATA_FACEBOOK_COMMENTS_INPUT_KEY=url
BRIGHTDATA_FACEBOOK_PAYLOAD_MODE=array
BRIGHTDATA_FACEBOOK_POSTS_MODE=scrape
BRIGHTDATA_X_POSTS_DATASET_ID=
BRIGHTDATA_X_COMMENTS_DATASET_ID=
BRIGHTDATA_X_POSTS_INPUT_KEY=url
BRIGHTDATA_X_POSTS_INPUTS=
BRIGHTDATA_X_COMMENTS_INPUT_KEY=url
BRIGHTDATA_X_PAYLOAD_MODE=array
BRIGHTDATA_X_POSTS_MODE=scrape
BRIGHTDATA_REDDIT_POSTS_DATASET_ID=
BRIGHTDATA_REDDIT_COMMENTS_DATASET_ID=
BRIGHTDATA_REDDIT_POSTS_INPUT_KEY=keyword
BRIGHTDATA_REDDIT_COMMENTS_INPUT_KEY=url
BRIGHTDATA_REDDIT_PAYLOAD_MODE=array
BRIGHTDATA_REDDIT_POSTS_MODE=discovery
# Optional review/voice sources. They use the same normalized opportunity and
# comment tables but are not enabled by default.
BRIGHTDATA_AMAZON_POSTS_DATASET_ID=
BRIGHTDATA_AMAZON_COMMENTS_DATASET_ID=
BRIGHTDATA_AMAZON_POSTS_INPUT_KEY=url
BRIGHTDATA_AMAZON_POSTS_INPUTS=
BRIGHTDATA_AMAZON_COMMENTS_INPUT_KEY=url
BRIGHTDATA_AMAZON_PAYLOAD_MODE=array
BRIGHTDATA_AMAZON_POSTS_MODE=scrape
BRIGHTDATA_GOOGLE_MAPS_POSTS_DATASET_ID=
BRIGHTDATA_GOOGLE_MAPS_COMMENTS_DATASET_ID=
BRIGHTDATA_GOOGLE_MAPS_POSTS_INPUT_KEY=url
BRIGHTDATA_GOOGLE_MAPS_POSTS_INPUTS=
BRIGHTDATA_GOOGLE_MAPS_COMMENTS_INPUT_KEY=url
BRIGHTDATA_GOOGLE_MAPS_PAYLOAD_MODE=array
BRIGHTDATA_GOOGLE_MAPS_POSTS_MODE=scrape
# Optional Google Trends validation through Bright Data SERP API.
GOOGLE_TRENDS_ENABLED=false
GOOGLE_TRENDS_KEYWORDS=pet cooling mat,walking pad,pantry organizer
BRIGHTDATA_SERP_ZONE=serp_api1
