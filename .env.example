POSTGRES_DB=trend_radar
POSTGRES_USER=trend_radar
POSTGRES_PASSWORD=replace_with_a_long_random_password
TZ=Asia/Shanghai
# Add the replacement Bright Data key here on the server only.
BRIGHTDATA_API_TOKEN=
COLLECTION_INTERVAL_SECONDS=86400
POSTS_PER_KEYWORD=3
# Limit daily Bright Data comment calls to protect the free quota.
COLLECT_COMMENTS=true
MAX_COMMENT_POSTS_PER_RUN=3
# Optional Google Trends validation through Bright Data SERP API.
GOOGLE_TRENDS_ENABLED=false
GOOGLE_TRENDS_KEYWORDS=pet cooling mat,walking pad,pantry organizer
BRIGHTDATA_SERP_ZONE=serp_api1
